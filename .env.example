# 全局环境变量示例。复制为各 Skill 目录下的 .env 后填写。
# .env 已被 .gitignore 排除，切勿提交任何真实密钥。

# ---- 运行日期（留空取当天）----
RUN_DATE=

# ---- 数据管道（Skill 1）----
# 东方财富接口如需 Cookie；westock CLI 鉴权如需 APIKey
EASTMONEY_COOKIE=
WESTOCK_API_KEY=

# ---- 邮件通知（Skill 3）----
# 收件邮箱
NOTIFY_TO=you@example.com
# QQ 邮箱需在「设置 → 账户」开启 SMTP 服务并生成「授权码」，
# 授权码不是登录密码，请勿填写登录密码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_account@qq.com
SMTP_PASSWORD=YOUR_SMTP_AUTH_CODE

# ---- 可选 webhook ----
WEBHOOK_URL=

# ---- 方案 B：内嵌调度服务（云沙箱，见 docs/ENVIRONMENT_NOTES.md）----
# 公网部署务必设置一个随机 token，防止 /wakeup 被任意人触发执行脚本。
# 生成示例：python3 -c "import secrets; print(secrets.token_urlsafe(24))"
WAKEUP_TOKEN=
SCHEDULER_HOST=0.0.0.0
SCHEDULER_PORT=8080
SCHEDULER_TZ=Asia/Shanghai
# 可选：指定调度配置文件（相对仓库根目录）
SCHEDULER_CONFIG=

# ---- 运行环境 ----
# 方案 A（VPS/本地 cron）才需要显式指定解释器，避免系统裸环境缺少依赖。
# 方案 B 的 embedded_scheduler.py 默认使用 sys.executable，无需设置本项。
# 例如 PYTHON_BIN=/path/to/your/python3 （按你的实际环境填写）
PYTHON_BIN=
