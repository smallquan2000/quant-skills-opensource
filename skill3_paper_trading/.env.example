# 复制为 .env 后填写真实值；.env 已被 .gitignore 排除，切勿提交。
# 所有值均为占位符。未填写时邮件通道自动降级为 dry-run（只打印不发送）。

NOTIFY_TO=you@example.com

# QQ 邮箱 SMTP 授权码（不是登录密码）：邮箱设置 → 账户 → 开启 SMTP 服务 → 生成授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_account@qq.com
SMTP_PASSWORD=YOUR_SMTP_AUTH_CODE

# 可选：企业微信 / 钉钉 / 自定义 webhook
WEBHOOK_URL=

# 可选：运行日期
RUN_DATE=
